
erDiagram
    USERS ||--o| STUDENT_PROFILES : has
    USERS ||--o{ STUDENT_CAREER_INTERESTS : selects
    CAREERS ||--o{ STUDENT_CAREER_INTERESTS : interests

    SECTORS ||--o{ CAREERS : contains

    USERS ||--o{ STUDENT_SKILLS : has
    SKILLS ||--o{ STUDENT_SKILLS : records

    CAREERS ||--o{ CAREER_SKILLS : requires
    SKILLS ||--o{ CAREER_SKILLS : required_for

    ASSESSMENTS ||--o{ ASSESSMENT_SKILLS : measures
    SKILLS ||--o{ ASSESSMENT_SKILLS : measured_by

    ASSESSMENTS ||--o{ QUESTIONS : contains
    QUESTIONS ||--o{ QUESTION_OPTIONS : offers

    USERS ||--o{ ASSESSMENT_ATTEMPTS : takes
    ASSESSMENTS ||--o{ ASSESSMENT_ATTEMPTS : receives

    ASSESSMENT_ATTEMPTS ||--o{ ASSESSMENT_ANSWERS : contains
    QUESTIONS ||--o{ ASSESSMENT_ANSWERS : answered_in
    QUESTION_OPTIONS o|--o{ ASSESSMENT_ANSWERS : selected_in

